# Cloudflare static asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Built files carry a content hash in their names, so they never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and icons keep their names across builds; cache for a week, then check.
/fonts/*
  Cache-Control: public, max-age=604800

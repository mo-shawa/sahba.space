---
import '@fontsource-variable/mona-sans/wdth.css'
import monaSans from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url'
import 'lenis/dist/lenis.css'
import '../styles/site.css'
import { education, person, siteMeta, socialLinks } from '../data/siteContent'

interface Props {
	title?: string
	description?: string
}

const { title = siteMeta.title, description = siteMeta.description } =
	Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? siteMeta.url)

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: person.name,
	url: siteMeta.url,
	description,
	sameAs: socialLinks.filter((link) => link.external).map((link) => link.href),
	alumniOf: education
		.filter((entry) => !entry.note)
		.map((entry) => ({
			'@type': 'CollegeOrUniversity',
			name: entry.institution,
		})),
}
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>
		<title>{title}</title>
		<meta
			name="description"
			content={description}
		/>
		<link
			rel="canonical"
			href={canonical}
		/>
		<meta
			name="theme-color"
			content="#040506"
		/>
		<meta
			property="og:type"
			content="website"
		/>
		<meta
			property="og:title"
			content={title}
		/>
		<meta
			property="og:description"
			content={description}
		/>
		<meta
			property="og:url"
			content={canonical}
		/>
		<meta
			name="twitter:card"
			content="summary"
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link
			rel="manifest"
			href="/site.webmanifest"
		/>
		<link
			rel="preload"
			href={monaSans}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<script is:inline>
			document.documentElement.classList.add('js')
			if (/[?&]skipIntro=(1|true)\b/i.test(location.search)) {
				document.documentElement.classList.add('skip-intro')
			}
		</script>
		<!--
			The curtain, styled here rather than in the bundle so it is on screen
			from the first paint: no fonts, scripts or images involved. It covers
			the page while it loads, and again for in-page travel (see
			src/scripts/page/curtain.ts). Without JavaScript it never shows; if the
			script never arrives, the animation below lifts it after 4 seconds.
		-->
		<style is:inline>
			html.js { background: #040506; }
			.curtain { display: none; }
			html.js .curtain {
				display: block;
				position: fixed;
				inset: 0;
				z-index: 60;
				overflow: hidden;
				color: #ecebe6;
				--ink: #ecebe6;
				--ink-soft: #9a9993;
				pointer-events: auto;
			}
			.curtain__sheet {
				position: absolute;
				inset: 0;
				background: #040506;
			}
			html.js .curtain[data-state='intro'] { animation: curtain-failsafe 0.8s ease 4s forwards; }
			html.js .curtain[data-state='open'] { visibility: hidden; pointer-events: none; }
			html.skip-intro .curtain[data-state='intro'] { display: none; }
			html.curtain-jump body > :not(.curtain):not(.cosmos) { visibility: hidden !important; }
			@keyframes curtain-failsafe { to { opacity: 0; visibility: hidden; } }
			.curtain__star {
				position: absolute;
				left: 50%;
				top: 50%;
				width: 6px;
				height: 6px;
				margin: -3px 0 0 -3px;
				border-radius: 50%;
				background: #fff6ea;
				box-shadow: 0 0 10px 2px rgba(255, 226, 184, 0.6), 0 0 42px 12px rgba(255, 210, 150, 0.12);
				animation: curtain-star 2.6s ease-in-out infinite;
			}
			@keyframes curtain-star {
				0%, 100% { transform: scale(0.72); opacity: 0.55; }
				50% { transform: scale(1); opacity: 1; }
			}
			@media (prefers-reduced-motion: reduce) { .curtain__star { animation: none; } }
			.curtain__stage { position: absolute; left: 0; right: 0; top: 0; height: 100vh; }
		</style>
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<div
			class="curtain"
			aria-hidden="true"
			data-state="intro"
			data-curtain
		>
			<div class="curtain__sheet">
				<div class="curtain__star"></div>
				<div
					class="curtain__stage"
					data-curtain-stage
				></div>
			</div>
		</div>
		<a
			class="skip-link"
			href="#main">Skip to content</a
		>
		<slot />
	</body>
</html>

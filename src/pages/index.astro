---
const redirectTo = '/home'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			http-equiv="refresh"
			content={`0;url=${redirectTo}`}
		/>
		<link
			rel="canonical"
			href={redirectTo}
		/>
		<title>Redirecting...</title>
	</head>
	<body>
		<script>
			window.location.replace('/home')
		</script>
		<p>
			<a href={redirectTo}>Continue to the homepage</a>
		</p>
	</body>
</html>
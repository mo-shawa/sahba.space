---
import ResearchGroup from './common/ResearchGroup.astro'
import SectionTitle from './common/SectionTitle.astro'
import { pageHeadings, researchGroups, researchProfileLink } from '../data/siteContent'
---

<section
	id="research"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.research.title}
		arabicTitle={pageHeadings.research.arabicTitle}
		eyebrow={pageHeadings.research.eyebrow}
		description={pageHeadings.research.summary}
		stats={pageHeadings.research.stats}
	/>
	<div class="section-container darken">
		{
			researchGroups.map((group) => (
				<ResearchGroup group={group} />
			))
		}
		<a
			target={researchProfileLink.target}
			rel={researchProfileLink.rel}
			class="rg-btn"
			href={researchProfileLink.href}
		>
			{researchProfileLink.label}
		</a>
	</div>
</section>
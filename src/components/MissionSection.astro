---
import Chapter from './common/Chapter.astro'
import Words from './common/Words.astro'
import { groundContent } from '../data/siteContent'

// Beats share the chapter evenly after the opening statement.
const [jsri, psi] = groundContent.founded
---

<Chapter
	name="ground"
	length={3.6}
	labelledby="ground-title"
>
	<div
		class="beat"
		data-beat="0.12,0.44"
	>
		<p class="small soft"><Words text={groundContent.label} /></p>
		<h2
			id="ground-title"
			class="title"
		>
			<Words text={groundContent.title} />
		</h2>
		<p class="beat__statement large"><Words text={groundContent.statement} /></p>
	</div>

	{
		[
			{ beat: jsri, timing: '0.48,0.73' },
			{ beat: psi, timing: '0.77,1' },
		].map(
			({ beat, timing }) =>
				beat && (
					<div
						class="beat"
						data-beat={timing}
					>
						<p class="large beat__founded">
							<Words text={beat.statement} />
						</p>
						{beat.href && (
							<p class="small">
								<a
									class="link"
									href={beat.href}
									target="_blank"
									rel="noreferrer"
								>
									<Words text={beat.linkLabel} />
								</a>
							</p>
						)}
					</div>
				)
		)
	}
</Chapter>

<style>
	.beat {
		grid-column: 1 / span 8;
		align-self: start;
		display: grid;
		gap: 1.5rem;
		padding-top: 4vh;
	}

	.beat .title {
		margin-left: -0.04em;
	}

	.beat__statement {
		max-width: 18em;
	}

	.beat__founded {
		max-width: 19em;
	}

	.soft {
		color: var(--night-ink-soft);
	}

	@media (max-width: 800px) {
		.beat {
			grid-column: 1 / -1;
		}
	}
</style>

---
import { brand, mobileNavigationItems, navigationItems } from '../data/siteContent'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'

function isActivePath(href?: string) {
	if (!href) return false
	if (href === '/home') {
		return pathname === '/' || pathname === '/home'
	}

	return pathname === href
}
---

<nav>
	<div class="nav-item">
		<a
			id="moon-icon"
			href={brand.href}
			class="nav-link nav-brand-icon"
		>
			<img
				width={brand.icon.width}
				height={brand.icon.height}
				src={brand.icon.src}
				alt={brand.icon.alt}
			/>
		</a>
		<a
			href={brand.href}
			class="nav-link nav-brand-link"
		>
			{brand.label}
		</a>
	</div>

	<div
		id="desktop-nav"
		class="nav-item"
	>
		<ul class="nav-links">
			{
				navigationItems.map((item) => {
					const groupActive = item.children?.some((child) => isActivePath(child.href))

					return item.children ? (
						<li class:list={['nav-group', groupActive && 'nav-group--active']}>
							<button
								type="button"
								class="nav-link nav-group-trigger"
								aria-haspopup="true"
							>
								{item.label}
							</button>
							<ul class="nav-submenu">
								{
									item.children.map((child) => (
										<li>
											<a
												class:list={['nav-link', 'nav-submenu-link', isActivePath(child.href) && 'nav-link--active']}
												href={child.href}
											>
												{child.label}
											</a>
										</li>
									))
								}
							</ul>
						</li>
					) : (
						<li>
							<a
								class:list={['nav-link', isActivePath(item.href) && 'nav-link--active']}
								href={item.href}
							>
								{item.label}
							</a>
						</li>
					)
				})
			}
		</ul>
	</div>
	<button
		type="button"
		id="hamburger"
		aria-controls="mobile-nav"
		aria-expanded="false"
		aria-label="Open navigation menu"
	>
		<img
			src="/svg/hamburger.svg"
			alt=""
			class="hamburger-icon"
			width="32"
			height="32"
			aria-hidden="true"
		/>
	</button>
</nav>
<div
	id="mobile-nav"
	class="nav-item"
	hidden
>
	<ul class="mobile-links">
		{
			mobileNavigationItems.map((item) => (
				<li>
					<a
						class:list={['mobile-link', isActivePath(item.href) && 'nav-link--active']}
						href={item.href}
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</div>
---
import Chapter from './common/Chapter.astro'
import SocialLink from './common/SocialLink.astro'
import Words from './common/Words.astro'
import { footerContent, person, socialLinks, visionStatement } from '../data/siteContent'

const email = socialLinks.find((link) => link.label === 'Email')!
const otherLinks = socialLinks.filter((link) => link !== email)
const year = new Date().getFullYear()
---

<Chapter
	name="home"
	length={3}
	id="contact"
	labelledby="contact-title"
>
	{
		visionStatement && (
			<p
				class="vision large"
				data-beat="0.2,0.58"
			>
				<Words text={visionStatement} />
			</p>
		)
	}

	<div
		class="contact"
		data-beat="0.64,1"
	>
		<h2
			id="contact-title"
			class="contact__title small soft"
		>
			<Words text="Contact" />
			<span
				class="contact__arabic"
				lang="ar"
				dir="rtl"><Words text="تواصل" /></span
			>
		</h2>
		<a
			class="contact__email"
			href={email.href}
		>
			<Words text={email.handle} />
		</a>
		<p class="contact__links small">
			{otherLinks.map((link) => <SocialLink link={link} />)}
		</p>
	</div>

	<footer
		class="footer small"
		data-beat="0.64,1"
	>
		<p class="soft">
			<Words text={`© ${year} ${footerContent.owner}`} />
		</p>
		<p
			class="soft footer__arabic"
			lang="ar"
			dir="rtl"
		>
			<Words text={person.nameArabic} />
		</p>
		<p class="soft">
			<span class="w"><span>Website by</span></span>
			<a
				class="link"
				href={footerContent.creditHref}
				target="_blank"
				rel="noreferrer"><Words text={footerContent.creditLabel} /></a
			>
		</p>
	</footer>
</Chapter>

<style>
	.vision {
		grid-column: 1 / span 7;
		align-self: center;
		max-width: 20em;
	}

	.contact__title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.contact__arabic {
		font-family: var(--arabic);
		font-size: 1.1rem;
	}

	.contact {
		grid-column: 1 / span 8;
		align-self: center;
		display: grid;
		justify-items: start;
		gap: 1.5rem;
	}

	.contact__email {
		font-size: clamp(2.4rem, 7.2vw, 8.5rem);
		font-weight: 480;
		font-stretch: 105%;
		line-height: 0.9;
		letter-spacing: -0.045em;
		margin-left: -0.04em;
		transition: color 300ms var(--ease-out);
	}

	.contact__email:hover {
		color: var(--signal-night);
	}

	.contact__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	.footer {
		grid-column: 1 / -1;
		align-self: end;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}

	.footer__arabic {
		font-family: var(--arabic);
		font-size: 1.05rem;
		line-height: 1.2;
	}

	.soft {
		color: var(--night-ink-soft);
	}

	@media (max-width: 800px) {
		.contact,
		.vision {
			grid-column: 1 / -1;
		}

		.vision {
			align-self: end;
		}
	}
</style>

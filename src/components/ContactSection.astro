---
import SectionTitle from './common/SectionTitle.astro'
import SocialLink from './common/SocialLink.astro'
import { pageHeadings, socialLinks } from '../data/siteContent'
---

<section
	id="contact"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.contact.title}
		arabicTitle={pageHeadings.contact.arabicTitle}
		eyebrow={pageHeadings.contact.eyebrow}
		description={pageHeadings.contact.summary}
		stats={pageHeadings.contact.stats}
	/>
	<div class="section-container darken contact-panel">
		<div class="social-links-panel social-links-panel--contact">
			{
				socialLinks.map((link) => (
					<SocialLink link={link} />
				))
			}
		</div>
	</div>
</section>
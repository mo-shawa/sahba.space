---
import { Image } from 'astro:assets'
import RecognitionSection from './RecognitionSection.astro'
import RichTextInline from './common/RichTextInline.astro'
import SectionTitle from './common/SectionTitle.astro'
import { aboutContent } from '../data/siteContent'
---

<section
	id="about"
	class="about paper"
	aria-labelledby="about-title"
>
	<SectionTitle
		title="About"
		id="about-title"
	/>

	<div class="about__body grid">
		<figure
			class="about__portrait"
			data-reveal
		>
			<Image
				src={aboutContent.portrait.image}
				alt={aboutContent.portrait.alt}
				widths={[480, 800]}
				sizes="(max-width: 800px) 75vw, 30vw"
				loading="lazy"
			/>
			<figcaption class="small soft">{aboutContent.portraitCaption}</figcaption>
		</figure>

		<div
			class="about__bio"
			data-reveal
		>
			<RichTextInline html={aboutContent.bioHtml} />
		</div>
	</div>

	<RecognitionSection />
</section>

<style>
	.about {
		padding-block: var(--section) var(--section);
	}

	.about__body {
		row-gap: 3rem;
		padding-bottom: clamp(4rem, 9vw, 8rem);
	}

	.about__portrait {
		grid-column: 1 / span 4;
		display: grid;
		gap: 0.75rem;
		align-self: start;
	}

	.about__portrait img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 20%;
	}

	.about__bio {
		grid-column: 6 / span 6;
		display: grid;
		gap: 1.25em;
		font-size: var(--t-medium);
		line-height: 1.45;
		letter-spacing: -0.005em;
		max-width: 36em;
	}

	.about__bio :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		text-decoration-color: var(--rule);
		transition: text-decoration-color 300ms var(--ease-out);
	}

	.about__bio :global(a:hover) {
		text-decoration-color: var(--signal);
	}

	@media (max-width: 800px) {
		.about__portrait {
			grid-column: 1 / span 9;
		}

		.about__bio {
			grid-column: 1 / -1;
		}
	}
</style>

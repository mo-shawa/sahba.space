---
import RichTextInline from './common/RichTextInline.astro'
import SocialLink from './common/SocialLink.astro'
import { aboutContent, homeFocusAreas, socialLinks } from '../data/siteContent'
---

<section
	id="about"
	class="page-section page-section--about"
>
	<div class="about-label">
		<span class="about-label-line"></span>
		<span class="about-label-text">About</span>
		<span class="about-label-line"></span>
	</div>
	<div class="intro-container home-intro-container">
		<div class="intro-aside">
			<div class="social-links-panel social-links-panel--home">
				{
					socialLinks.map((link) => (
						<SocialLink link={link} />
					))
				}
			</div>
			<div class="focus-panel">
				<p class="focus-panel-label">Focus areas</p>
				<ul class="focus-list">
					{
						homeFocusAreas.map((item) => (
							<li class="focus-item">{item}</li>
						))
					}
				</ul>
			</div>
		</div>
		<div class="intro-copy">
			{
				aboutContent.paragraphs.map((paragraph) => (
					<p class="intro-content">
						<RichTextInline parts={paragraph} />
					</p>
				))
			}
		</div>
	</div>
</section>
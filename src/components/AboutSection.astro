---
import RichTextInline from './common/RichTextInline.astro'
import SocialLink from './common/SocialLink.astro'
import SectionTitle from './common/SectionTitle.astro'
import { aboutContent, socialLinks } from '../data/siteContent'
---

<section
	id="home"
	class="page-section page-section--home"
>
	<SectionTitle
		title={aboutContent.title}
		arabicTitle={aboutContent.arabicTitle}
	/>
	<div class="intro-container home-intro-container">
		<div class="social-links-panel social-links-panel--home darken">
			{
				socialLinks.map((link) => (
					<SocialLink link={link} />
				))
			}
		</div>
		<div class="intro-copy">
			{
				aboutContent.paragraphs.map((paragraph) => (
					<p class="intro-content">
						<RichTextInline parts={paragraph} />
					</p>
				))
			}
		</div>
	</div>
</section>
---
import MediaCard from './common/MediaCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { featuredQuote, interviews, person } from '../data/siteContent'
---

<section
	id="interviews"
	class="interviews paper"
	aria-labelledby="interviews-title"
>
	<SectionTitle
		title="Interviews"
		id="interviews-title"
	/>

	<figure
		class="quote grid"
		data-reveal
	>
		<blockquote class="quote__text large">
			<p>“{featuredQuote.text}”</p>
		</blockquote>
		<figcaption class="quote__source small soft">
			{person.name}, quoted by the {featuredQuote.source}
		</figcaption>
	</figure>

	<ol class="interviews__list grid">
		{interviews.map((entry) => <MediaCard entry={entry} />)}
	</ol>

	<div
		class="preview"
		aria-hidden="true"
		data-preview-frame
	>
		<img
			alt=""
			decoding="async"
		/>
	</div>
</section>

<style>
	.interviews {
		padding-block: var(--section) 0;
	}

	.quote {
		row-gap: 1rem;
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}

	.quote__text {
		grid-column: 3 / span 8;
		text-indent: -0.4em;
	}

	.quote__source {
		grid-column: 3 / span 8;
	}

	.preview {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 5;
		width: clamp(12rem, 18vw, 17rem);
		aspect-ratio: 4 / 5;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transform: translate3d(-50%, -50%, 0) scale(0.92);
		transition:
			opacity 300ms var(--ease-out),
			scale 500ms var(--ease-out);
	}

	.preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 800px) {
		.quote__text,
		.quote__source {
			grid-column: 1 / -1;
		}
	}

	@media (hover: none), (max-width: 800px) {
		.preview {
			display: none;
		}
	}
</style>

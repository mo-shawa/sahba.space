---
import MediaCard from './common/MediaCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { interviews, pageHeadings } from '../data/siteContent'
---

<section
	id="interviews"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.interviews.title}
		arabicTitle={pageHeadings.interviews.arabicTitle}
	/>
	<div class="flex-card-container">
		{
			interviews.map((entry) => (
				<MediaCard entry={entry} />
			))
		}
	</div>
</section>
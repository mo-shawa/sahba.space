---
import MediaCard from './common/MediaCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { interviews, pageHeadings } from '../data/siteContent'
---

<section
	id="interviews"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.interviews.title}
		arabicTitle={pageHeadings.interviews.arabicTitle}
		eyebrow={pageHeadings.interviews.eyebrow}
		description={pageHeadings.interviews.summary}
		stats={pageHeadings.interviews.stats}
	/>
	<div class="media-list media-list--interviews">
		{
			interviews.map((entry, index) => (
				<MediaCard
					entry={entry}
					index={index}
				/>
			))
		}
	</div>
</section>
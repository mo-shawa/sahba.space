---
import MediaCard from './common/MediaCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { lectures, pageHeadings } from '../data/siteContent'
---

<section
	id="lectures"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.lectures.title}
		arabicTitle={pageHeadings.lectures.arabicTitle}
		eyebrow={pageHeadings.lectures.eyebrow}
		description={pageHeadings.lectures.summary}
		stats={pageHeadings.lectures.stats}
	/>
	<div class="media-list media-list--lectures">
		{
			lectures.map((entry, index) => (
				<MediaCard
					entry={entry}
					index={index}
				/>
			))
		}
	</div>
</section>
---
import { Image } from 'astro:assets'
import SectionTitle from './common/SectionTitle.astro'
import { lectures } from '../data/siteContent'
---

<section
	id="lectures"
	class="lectures paper"
	aria-labelledby="lectures-title"
>
	<SectionTitle
		title="Lectures"
		arabic="محاضرات"
		id="lectures-title"
	/>

	<ol class="lectures__list grid">
		{
			lectures.map((lecture) => (
				<li
					class="talk"
					data-reveal
				>
					<a
						class="talk__image"
						href={lecture.href}
						target="_blank"
						rel="noreferrer"
						tabindex="-1"
						aria-hidden="true"
					>
						<Image
							src={lecture.image}
							alt=""
							widths={[640, 1280]}
							sizes="(max-width: 800px) 100vw, 33vw"
							loading="lazy"
						/>
					</a>
					<div class="talk__text">
						<p class="talk__meta small">
							<time
								class="numeric"
								datetime={lecture.dateTime}
							>
								{lecture.date}
							</time>
							<span>{lecture.host}</span>
						</p>
						<h3 class="talk__title large">
							<a
								href={lecture.href}
								target="_blank"
								rel="noreferrer"
							>
								{lecture.title || lecture.context}
							</a>
						</h3>
						{lecture.title && lecture.context && (
							<p class="talk__context soft">{lecture.context}</p>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.lectures {
		padding-block: var(--section) 0;
	}

	.lectures__list {
		row-gap: clamp(2.5rem, 5vw, 4.5rem);
	}

	.talk {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		row-gap: 1.5rem;
		padding-top: var(--gap);
		border-top: 1px solid var(--rule);
	}

	.talk__image {
		grid-column: 1 / span 4;
		overflow: hidden;
		background: var(--ink);
	}

	.talk__image img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 1.2s var(--ease-out);
	}

	.talk:hover .talk__image img {
		transform: scale(1.03);
	}

	.talk__text {
		grid-column: 6 / -1;
		display: grid;
		align-content: start;
		gap: 1rem;
	}

	.talk__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.talk__meta span {
		color: var(--ink-soft);
	}

	.talk__title {
		max-width: 22em;
	}

	.talk__title a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.12em;
	}

	.talk__context {
		max-width: 32em;
	}

	@media (max-width: 800px) {
		.talk__image,
		.talk__text {
			grid-column: 1 / -1;
		}
	}
</style>

---
import Chapter from './common/Chapter.astro'
import Words from './common/Words.astro'
import { earthContent, education } from '../data/siteContent'

const phd = education.find((entry) => entry.degree === 'PhD')
---

<Chapter
	name="earth"
	length={3}
	labelledby="earth-title"
>
	<div
		class="intro"
		data-beat="0.12,0.52"
	>
		<p class="small soft"><Words text={earthContent.label} /></p>
		<h2
			id="earth-title"
			class="title"
		>
			<Words text={earthContent.title} />
		</h2>
		<p class="intro__statement medium"><Words text={earthContent.statement} /></p>
	</div>

	<div
		class="now"
		data-beat="0.56,1"
	>
		{earthContent.current && <p class="large"><Words text={earthContent.current} /></p>}
		{
			phd && (
				<p class="small soft">
					<Words text={`${phd.degree}, ${phd.field}, ${phd.institution}`} />
				</p>
			)
		}
		{
			earthContent.related.length > 0 && (
				<ul class="now__papers small">
					{earthContent.related.map((paper) => (
						// prettier-ignore
						<li data-fade><a class="link" href={`#pub-${paper.id}`}>{paper.title} ({paper.venue.short} {paper.year})</a></li>
					))}
				</ul>
			)
		}
	</div>

	<div
		class="place place--west"
		data-place-label="palestine"
		aria-hidden="true"
	>
		<span class="place__label small">Palestine</span>
		<span class="place__line"></span>
	</div>
	<div
		class="place"
		data-place-label="jordan"
		aria-hidden="true"
	>
		<span class="place__line"></span>
		<span class="place__label small">Jordan</span>
	</div>
</Chapter>

<style>
	.intro,
	.now {
		grid-column: 1 / span 6;
		align-self: center;
		display: grid;
		gap: 1.5rem;
	}

	.intro .title {
		margin-left: -0.04em;
		max-width: 8em;
	}

	.intro__statement {
		max-width: 26em;
		color: var(--night-ink-soft);
	}

	.now .large {
		max-width: 17em;
	}

	.now__papers {
		display: grid;
		gap: 0.6rem;
		max-width: 30em;
	}

	.soft {
		color: var(--night-ink-soft);
	}

	/* Track Palestine and Jordan on the globe; positioned every frame. */
	.place {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		opacity: 0;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.place__line {
		width: 3rem;
		height: 1px;
		background: var(--signal-night);
	}

	.place__label {
		color: var(--night-ink);
		white-space: nowrap;
	}

	@media (max-width: 800px) {
		.intro,
		.now {
			grid-column: 1 / -1;
			align-self: end;
		}

		.place__line {
			width: 1.75rem;
		}
	}
</style>

---
import SectionTitle from './common/SectionTitle.astro'
import TestimonialCard from './common/TestimonialCard.astro'
import { testimonials } from '../data/siteContent'
---

<section
	id="testimonials"
	class="testimonials paper"
	aria-labelledby="testimonials-title"
>
	<SectionTitle
		title="Testimonials"
		arabic="توصيات"
		id="testimonials-title"
	/>

	<div class="grid">
		{testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
	</div>
</section>

<style>
	.testimonials {
		padding-block: var(--section) clamp(4rem, 10vw, 9rem);
	}
</style>

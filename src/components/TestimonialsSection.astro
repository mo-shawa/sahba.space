---
import SectionTitle from './common/SectionTitle.astro'
import TestimonialCard from './common/TestimonialCard.astro'
import { pageHeadings, testimonials } from '../data/siteContent'
---

<section
	id="testimonials"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.testimonials.title}
		arabicTitle={pageHeadings.testimonials.arabicTitle}
		eyebrow={pageHeadings.testimonials.eyebrow}
		description={pageHeadings.testimonials.summary}
		stats={pageHeadings.testimonials.stats}
	/>
	<div class="testimonial-list">
		{
			testimonials.map((testimonial, index) => (
				<TestimonialCard
					testimonial={testimonial}
					index={index}
				/>
			))
		}
	</div>
</section>
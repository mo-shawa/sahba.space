---
import LeadershipCard from './common/LeadershipCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { leadershipItems } from '../data/siteContent'
---

<section
	id="leadership"
	class="leadership paper"
	aria-labelledby="leadership-title"
>
	<SectionTitle
		title="Leadership"
		arabic="قيادة"
		id="leadership-title"
	/>

	<ol class="leadership__list grid">
		{leadershipItems.map((item) => <LeadershipCard item={item} />)}
	</ol>
</section>

<style>
	.leadership {
		padding-block: var(--section) 0;
	}

	.leadership__list > :global(:last-child) {
		border-bottom: 1px solid var(--rule);
	}
</style>

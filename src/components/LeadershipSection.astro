---
import LeadershipCard from './common/LeadershipCard.astro'
import SectionTitle from './common/SectionTitle.astro'
import { leadershipItems, pageHeadings } from '../data/siteContent'
---

<section
	id="leadership"
	class="page-section"
>
	<SectionTitle
		title={pageHeadings.leadership.title}
		arabicTitle={pageHeadings.leadership.arabicTitle}
		eyebrow={pageHeadings.leadership.eyebrow}
		description={pageHeadings.leadership.summary}
		stats={pageHeadings.leadership.stats}
	/>
	<div class="leadership-list">
		{
			leadershipItems.map((item, index) => (
				<LeadershipCard
					item={item}
					index={index}
				/>
			))
		}
	</div>
</section>
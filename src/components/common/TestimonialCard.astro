---
import RichTextInline from './RichTextInline.astro'
import type { Testimonial } from '../../data/siteContent'

interface Props {
	testimonial: Testimonial
}

const { testimonial } = Astro.props
---

<figure
	class="voice"
	data-reveal
>
	<figcaption class="voice__person">
		<span class="medium">{testimonial.name}</span>
		<span class="small soft"><RichTextInline html={testimonial.roleHtml} /></span>
		<span class="small soft numeric">{testimonial.year}</span>
	</figcaption>
	<div class="voice__words">
		<blockquote class="voice__excerpt large">
			<p>“<RichTextInline html={testimonial.excerptHtml} />”</p>
		</blockquote>
		{
			testimonial.hasMore && (
				<details class="voice__more">
					<summary class="small">
						<span class="voice__open">Read the full testimonial</span>
						<span class="voice__close">Close</span>
					</summary>
					<blockquote class="voice__quote">
						<RichTextInline html={testimonial.quoteHtml} />
					</blockquote>
				</details>
			)
		}
	</div>
</figure>

<style>
	.voice {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		row-gap: 1.5rem;
		padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--rule);
	}

	.voice__person {
		grid-column: 1 / span 4;
		display: grid;
		align-content: start;
		gap: 0.3rem;
		max-width: 20rem;
	}

	.voice__person :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.voice__words {
		grid-column: 6 / span 7;
		display: grid;
		gap: 1.25rem;
		align-content: start;
	}

	.voice__excerpt {
		max-width: 20em;
		text-indent: -0.42em;
	}

	.voice__excerpt :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.12em;
	}

	.voice__more summary {
		display: inline-flex;
		cursor: pointer;
		list-style: none;
		color: var(--ink-soft);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		text-decoration-color: var(--rule);
		transition:
			color 300ms var(--ease-out),
			text-decoration-color 300ms var(--ease-out);
	}

	.voice__more summary::-webkit-details-marker {
		display: none;
	}

	.voice__more summary:hover {
		color: var(--ink);
		text-decoration-color: var(--signal);
	}

	.voice__close,
	.voice__more[open] .voice__open {
		display: none;
	}

	.voice__more[open] .voice__close {
		display: inline;
	}

	.voice__quote {
		display: grid;
		gap: 1em;
		margin-top: 1.25rem;
		font-size: var(--t-medium);
		line-height: 1.45;
		letter-spacing: -0.005em;
		max-width: 36em;
	}

	/* The line each testimonial is remembered by (bold in the CMS). */
	.voice__quote :global(strong) {
		font-weight: 560;
	}

	.voice__quote :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		text-decoration-color: var(--rule);
	}

	@media (max-width: 800px) {
		.voice__person,
		.voice__words {
			grid-column: 1 / -1;
		}
	}
</style>

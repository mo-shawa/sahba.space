---
import RichTextInline from './RichTextInline.astro'
import type { Testimonial } from '../../data/siteContent'

interface Props {
	testimonial: Testimonial
}

const { testimonial } = Astro.props
---

<article class="card testimonial-card">
	<blockquote class="testimonial-copy">
		{
			testimonial.quote.map((paragraph) => (
				<p>
					<RichTextInline parts={paragraph} />
				</p>
			))
		}
	</blockquote>
	<small class="testimonial-attribution">
		<RichTextInline parts={testimonial.attribution} />
	</small>
</article>
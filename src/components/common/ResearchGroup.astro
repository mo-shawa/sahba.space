---
import type { Publication } from '../../data/siteContent'

interface Props {
	year: number
	publications: Publication[]
	/** Hidden until the reader asks for the full list. */
	extra?: boolean
}

const { year, publications, extra } = Astro.props
---

<li
	class="year"
	data-year-group
	data-extra={extra || undefined}
>
	<h3 class="year__label numeric">{year}</h3>
	<ol class="year__rows">
		{
			publications.map((publication) => {
				const venue = publication.venue
				return (
					<li
						class:list={['pub', publication.href && 'pub--link']}
						id={`pub-${publication.id}`}
						data-group={publication.group}
					>
						<p class="pub__title">
							{publication.href ? (
								// prettier-ignore
								<a class="pub__link" href={publication.href} target="_blank" rel="noreferrer">{publication.title}</a>
							) : (
								publication.title
							)}
							{publication.detail && (
								<span class="pub__detail small">{publication.detail}</span>
							)}
						</p>
						<p class="pub__venue small">
							<abbr title={venue.detail ? `${venue.name}, ${venue.detail}` : venue.name}>
								{venue.short}
							</abbr>
						</p>
						<p class="pub__authors small">{publication.authors}</p>
					</li>
				)
			})
		}
	</ol>
</li>

<style>
	.year {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		border-top: 1px solid var(--ink);
	}

	.year[hidden] {
		display: none;
	}

	.year__label {
		grid-column: 1 / span 2;
		padding-top: 1.1rem;
		font-size: var(--t-medium);
		font-weight: 460;
	}

	.year__rows {
		grid-column: 3 / -1;
		display: grid;
		grid-template-columns: subgrid;
	}

	.pub {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
		align-items: baseline;
		padding-block: 1.1rem 1.2rem;
		scroll-margin-top: 30vh;
		transition: background-color 300ms var(--ease-out);
	}

	.pub + .pub:not([hidden]),
	.pub[hidden] + .pub {
		border-top: 1px solid var(--rule);
	}

	.pub__title {
		grid-column: 1 / span 6;
		display: grid;
		gap: 0.35rem;
		font-size: var(--t-medium);
		font-weight: 460;
		line-height: 1.25;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.pub__detail {
		font-weight: 400;
		letter-spacing: 0;
		color: var(--ink-soft);
	}

	.pub__venue {
		grid-column: 7 / span 2;
	}

	.pub__venue abbr {
		text-decoration: none;
		cursor: help;
	}

	.pub__authors {
		grid-column: 9 / span 2;
		color: var(--ink-soft);
	}

	.pub:target .pub__title {
		color: var(--signal);
	}

	/* A paper with a link: the whole row opens it. On hover an ink panel sweeps
	   across from the left, inverting what it covers, and the title steps in. */
	.pub--link {
		position: relative;
		isolation: isolate;
		background: var(--paper);
	}

	.pub--link::before {
		content: '';
		position: absolute;
		inset: 0 -0.75rem;
		z-index: 1;
		background: var(--paper);
		mix-blend-mode: difference;
		pointer-events: none;
		transform: scaleX(0);
		transform-origin: right center;
		transition: transform 700ms var(--ease-out);
	}

	.pub__link {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
		text-decoration-color: var(--rule-strong);
		transition: text-decoration-color 300ms var(--ease-out);
	}

	.pub__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.pub--link .pub__title {
		transition: transform 700ms var(--ease-out);
	}

	@media (hover: hover) {
		.pub--link:hover::before {
			transform: scaleX(1);
			transform-origin: left center;
		}

		.pub--link:hover .pub__title {
			transform: translateX(0.75rem);
		}

		.pub--link:hover .pub__link {
			text-decoration-color: transparent;
		}
	}

	.pub--link:has(.pub__link:focus-visible)::before {
		transform: scaleX(1);
		transform-origin: left center;
	}

	@media (max-width: 800px) {
		.year__label {
			grid-column: 1 / -1;
		}

		.year__rows {
			grid-column: 1 / -1;
		}

		.pub {
			grid-template-columns: auto 1fr;
			column-gap: 1rem;
			row-gap: 0.4rem;
		}

		.pub__title {
			grid-column: 1 / -1;
		}

		.pub__venue,
		.pub__authors {
			grid-column: auto;
		}
	}
</style>

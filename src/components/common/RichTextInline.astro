---
import type { RichTextPart } from '../../data/siteContent'

interface Props {
	parts: RichTextPart[]
}

const { parts } = Astro.props
---

{
	parts.map((part) => {
		if (part.type === 'link') {
			return (
				<a
					href={part.href}
					target={part.target}
					rel={part.rel}
				>
					{part.value}
				</a>
			)
		}
		if (part.type === 'highlight') {
			return <mark>{part.value}</mark>
		}
		return part.value
	})
}

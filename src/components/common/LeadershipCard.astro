---
import RichTextInline from './RichTextInline.astro'
import type { LeadershipItem } from '../../data/siteContent'

interface Props {
	item: LeadershipItem
}

const { item } = Astro.props
---
<article class="card">
	<div class="card-top">
		<h3 class="card-title">{item.title}</h3>
	</div>
	<div class="card-body card-copy-group">
		{
			item.details.map((detail) => (
				<small class="card-copy">
					<RichTextInline parts={detail} />
				</small>
			))
		}
	</div>
	{
		item.website && (
			<a
				class="card-link"
				href={item.website.href}
				target={item.website.target}
				rel={item.website.rel}
			>
				{item.website.label}
			</a>
		)
	}
</article>
---
import Words from './Words.astro'
import type { SocialLink as SocialLinkContent } from '../../data/siteContent'

interface Props {
	link: SocialLinkContent
}

const { link } = Astro.props
---

<a
	class="social link"
	href={link.href}
	target={link.external ? '_blank' : undefined}
	rel={link.external ? 'noreferrer' : undefined}
>
	<Words text={link.label} />
</a>
